# Copy to .env and change what you need. .env is git-ignored: never commit it.

# PostgreSQL (used by docker compose)
POSTGRES_USER=dealwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dealwatch

# Only needed when running the API outside Docker.
# SQLite needs no setup:  sqlite:///./dealwatch.db
DATABASE_URL=postgresql+psycopg://dealwatch:change-me@localhost:5432/dealwatch

# Price source plug-in: "cheapshark" (real prices) or "fake" (offline demo)
PRICE_SOURCE=cheapshark
# Add demo watchlist + history on start (only with PRICE_SOURCE=fake)
DEMO_SEED=false

# Background price checker
SCHEDULER_ENABLED=true
CHECK_INTERVAL_HOURS=6
RUN_CHECK_ON_STARTUP=false

# Be polite to CheapShark
CHEAPSHARK_CACHE_SECONDS=600
CHEAPSHARK_MIN_INTERVAL_SECONDS=1

# Browser origins allowed to call the API directly (dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
